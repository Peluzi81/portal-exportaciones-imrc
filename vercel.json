{
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "api/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?_vpath=/api/:path*" },
    { "source": "/assets/img/:path*", "destination": "/api/index?_vpath=/assets/img/:path*" }
  ]
}
